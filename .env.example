# Copy to .env and fill in what you need. Every value is optional.

# The real academy: every Enroll / Buy / Register / Log in button opens a page there.
VITE_MAIN_SITE_URL=https://takxila.in

# Where THIS marketing site is hosted (canonical links, Open Graph, sitemap.xml).
VITE_SITE_URL=https://takxila.in

# Google Apps Script web app (tools/Code.gs) that emails the leads. Empty: the link in src/config/site.ts is used.
VITE_MAIL_WEBHOOK=

# Analytics: loaded only when set.
VITE_GA_ID=
VITE_META_PIXEL_ID=
