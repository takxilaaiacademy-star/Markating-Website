# Copy to .env and fill in what you need. Every value is optional.

# The real academy: every Enroll / Buy / Register / Log in button opens a page there.
VITE_MAIN_SITE_URL=https://takxila.in

# Where THIS marketing site is hosted (canonical links, Open Graph, sitemap.xml).
VITE_SITE_URL=https://takxila.in

# Google Apps Script web app (tools/Code.gs) that emails the leads. Empty: the link in src/config/site.ts is used.
VITE_MAIL_WEBHOOK=

# Analytics: loaded only when set.
VITE_GA_ID=
VITE_META_PIXEL_ID=

# Tx AI chatbot API (the takxila-ai-bot project), e.g. https://bot.takxila.in. Empty: the WhatsApp button opens WhatsApp only.
VITE_CHAT_API_URL=

# Gemini AI for the free resume, aptitude and interview tools. SERVER-SIDE ONLY: never prefix with VITE_.
# Create the key at https://aistudio.google.com/apikey (it starts with "AIza"). Empty: the tools run offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=
AI_REQUESTS_PER_HOUR=40
AI_ALLOWED_ORIGINS=
# Only when /api/ai is hosted on another domain.
VITE_AI_API_URL=
